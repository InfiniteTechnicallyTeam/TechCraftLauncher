<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefWidth="980" prefHeight="650" minWidth="760" minHeight="540"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="itt.tcl.ui.controller.MainController">

    <left>
        <VBox prefWidth="232" minWidth="210" spacing="14" styleClass="sidebar">
            <padding>
                <Insets top="30" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="11">
                <StackPane minWidth="38" minHeight="38" prefWidth="38" prefHeight="38"
                           maxWidth="38" maxHeight="38" styleClass="brand-mark-small">
                    <Text text="TC" styleClass="brand-mark-small-text"/>
                </StackPane>
                <VBox spacing="0">
                    <Text text="TECHCRAFT" styleClass="sidebar-brand-name"/>
                    <Text text="%brand.launcher" styleClass="sidebar-brand-kicker"/>
                </VBox>
            </HBox>

            <Text text="%nav.launcher" styleClass="nav-section-label">
                <VBox.margin>
                    <Insets top="24"/>
                </VBox.margin>
            </Text>
            <Button text="%nav.home" maxWidth="Infinity" alignment="CENTER_LEFT"
                    mnemonicParsing="false" styleClass="nav-button-active"/>
            <Button fx:id="downloadsBtn" text="%nav.downloads" maxWidth="Infinity"
                    alignment="CENTER_LEFT" mnemonicParsing="false"
                    styleClass="nav-button"/>
            <Button fx:id="settingsBtn" text="%nav.settings" maxWidth="Infinity"
                    alignment="CENTER_LEFT" mnemonicParsing="false"
                    styleClass="nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="12" styleClass="account-card">
                <HBox alignment="CENTER_LEFT" spacing="11">
                    <StackPane minWidth="38" minHeight="38" prefWidth="38" prefHeight="38"
                               maxWidth="38" maxHeight="38" styleClass="avatar">
                        <Label fx:id="avatarLabel" text="P" styleClass="avatar-text"/>
                    </StackPane>
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Text fx:id="accountText" text="%account.offlinePlayer"
                              styleClass="account-name"/>
                        <Text fx:id="accountTypeText" text="%account.offline"
                              styleClass="account-type"/>
                    </VBox>
                </HBox>
                <Button fx:id="logoutBtn" text="%account.signOut" maxWidth="Infinity"
                        mnemonicParsing="false" styleClass="signout-button"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="24" styleClass="content-pane">
            <padding>
                <Insets top="38" right="42" bottom="34" left="42"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Text text="%main.title" styleClass="page-title"/>
                    <Text text="%main.subtitle"
                          styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="4">
                    <Text text="%main.language" styleClass="language-label"/>
                    <ComboBox fx:id="languageCombo" prefWidth="118" prefHeight="34"
                              styleClass="language-combo"/>
                </VBox>
                <Label text="%main.badge" styleClass="version-badge">
                    <HBox.margin>
                        <Insets left="14"/>
                    </HBox.margin>
                </Label>
            </HBox>

            <VBox spacing="22" styleClass="launch-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="7">
                        <Text text="%main.edition" styleClass="eyebrow-text"/>
                        <Text text="%main.heroTitle" styleClass="hero-title"/>
                        <Text text="%main.heroDescription"
                              wrappingWidth="470" styleClass="hero-description"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <StackPane minWidth="92" minHeight="92" prefWidth="92" prefHeight="92"
                               maxWidth="92" maxHeight="92" styleClass="block-emblem">
                        <Text text="TCL" styleClass="block-emblem-text"/>
                    </StackPane>
                </HBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="9">
                    <HBox alignment="CENTER_LEFT">
                        <Text text="%main.gameVersion" styleClass="field-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Text fx:id="versionCountText" text="%main.scanning"
                              styleClass="meta-text"/>
                    </HBox>
                    <ComboBox fx:id="versionCombo" promptText="%main.chooseVersion"
                              maxWidth="Infinity" prefHeight="46"
                              styleClass="version-combo"/>
                </VBox>

                <Button fx:id="launchBtn" text="%main.launch"
                        maxWidth="Infinity" prefHeight="56"
                        mnemonicParsing="false" styleClass="launch-button"/>
            </VBox>

            <VBox spacing="10" styleClass="status-panel">
                <ProgressBar fx:id="progressBar" maxWidth="Infinity"
                             visible="false" managed="false"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Region minWidth="8" minHeight="8" prefWidth="8" prefHeight="8"
                            maxWidth="8" maxHeight="8" styleClass="status-dot"/>
                    <Text fx:id="statusText"
                          text="%main.status.default"
                          wrappingWidth="590" styleClass="status-text"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
