<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane prefWidth="820" prefHeight="600" minWidth="720" minHeight="520"
            styleClass="app-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="itt.tcl.ui.controller.SettingsController">

    <left>
        <VBox prefWidth="210" minWidth="190" spacing="14" styleClass="sidebar">
            <padding>
                <Insets top="30" right="24" bottom="24" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="11">
                <StackPane minWidth="38" minHeight="38" prefWidth="38" prefHeight="38"
                           maxWidth="38" maxHeight="38" styleClass="brand-mark-small">
                    <Text text="TC" styleClass="brand-mark-small-text"/>
                </StackPane>
                <VBox spacing="0">
                    <Text text="TECHCRAFT" styleClass="sidebar-brand-name"/>
                    <Text text="%brand.launcher" styleClass="sidebar-brand-kicker"/>
                </VBox>
            </HBox>

            <Text text="%nav.preferences" styleClass="nav-section-label">
                <VBox.margin>
                    <Insets top="24"/>
                </VBox.margin>
            </Text>
            <Button text="%nav.general" maxWidth="Infinity" alignment="CENTER_LEFT"
                    mnemonicParsing="false" styleClass="nav-button-active"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="backBtn" text="%settings.back"
                    maxWidth="Infinity" cancelButton="true"
                    mnemonicParsing="false" styleClass="secondary-button"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="content-pane">
            <padding>
                <Insets top="36" right="38" bottom="30" left="38"/>
            </padding>

            <VBox spacing="4">
                <Text text="%settings.title" styleClass="page-title"/>
                <Text text="%settings.subtitle"
                      styleClass="page-subtitle"/>
            </VBox>

            <VBox spacing="14" styleClass="settings-card">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Text text="%settings.downloadSource" styleClass="card-title"/>
                        <Text text="%settings.downloadSubtitle"
                              styleClass="card-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="%settings.network" styleClass="setting-tag"/>
                </HBox>
                <ComboBox fx:id="mirrorCombo" maxWidth="Infinity" prefHeight="43"
                          styleClass="version-combo"/>
                <Text fx:id="mirrorDescriptionText" wrappingWidth="500"
                      styleClass="helper-text"/>
            </VBox>

            <VBox spacing="14" styleClass="settings-card">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Text text="%settings.gameData" styleClass="card-title"/>
                        <Text text="%settings.gameDataSubtitle"
                              styleClass="card-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="openFolderBtn" text="%settings.openFolder"
                            mnemonicParsing="false" styleClass="ghost-button"/>
                </HBox>
                <Label maxWidth="Infinity" styleClass="path-label">
                    <graphic>
                        <Text fx:id="dataPathText" text=".minecraft" styleClass="path-text"/>
                    </graphic>
                </Label>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="about-card">
                <StackPane minWidth="50" minHeight="50" prefWidth="50" prefHeight="50"
                           maxWidth="50" maxHeight="50" styleClass="brand-mark-small">
                    <Text text="TC" styleClass="brand-mark-small-text"/>
                </StackPane>
                <VBox spacing="3">
                    <Text text="%settings.about" styleClass="card-title"/>
                    <Text text="%settings.edition" styleClass="card-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="%settings.build" styleClass="version-badge"/>
            </HBox>

            <Region VBox.vgrow="ALWAYS"/>
            <Text fx:id="settingsStatusText" wrappingWidth="500"
                  styleClass="status-text"/>
        </VBox>
    </center>
</BorderPane>
